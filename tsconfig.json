{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],

    "noEmit": true,
    "allowJs": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": true,

    // 打开这两个开关时实测 250 处，全部清完了（0 处），所以正式开在这里。
    //
    // 清的过程本身就是这轮最大的收获来源 —— 「声明了没读」几乎每一簇背后
    // 都是一个**接了一半的功能**：
    //   · fallbackQuestion 解构九个字段一个没用，其中一条还让纯函数能抛异常
    //   · 同伴控制命令全是门面，setControl 只有测试在调用
    //   · 整套决心系统三个方法各自只出现一次 —— 都是自己的定义
    //   · 五个空心测试：算出要检查的东西然后不看它
    //
    // 有意不用的**参数**以 `_` 开头（TS 只对参数认这个前缀，
    // 局部变量加了照报不误，那类必须真删）。
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
