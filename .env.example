# AI TRPG Server Configuration

# ── LLM API ──
# API key (required — one of these)
LLM_API_KEY=sk-your-key-here
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# API base URL
# OpenAI:   https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Ollama:   http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model name
# OpenAI:   gpt-4o-mini, gpt-4o
# DeepSeek: deepseek-chat
# Ollama:   llama3, qwen2.5
LLM_MODEL=gpt-4o-mini

# Generation settings
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# ── Server ──
PORT=3099
NODE_ENV=development

# ── Session ──
# Minutes of inactivity before auto-cleanup (default: 30)
SESSION_TIMEOUT_MINUTES=30

# ── 仓库外资源路径 ──
# 这几份在仓库之外，不同机器上的位置不一样：世界模型 229MB（v18 + 克苏鲁子模型）
# 与前端构建产物都不进 git。缺失时服务不会崩，只会静默降级（world-model-loader.ts
# 找不到文件时 log.warn 后跳过，KP 上下文注入/幻觉风险评分/规则映射失效；
# 前端目录缺失时回落到内置测试页）。加载是懒的：世界模型在第一次建会话时才读，
# 服务启动本身不受影响。详见 docs/deploy.md「二、构建前必须先放世界模型」。
#
# 下面是相对路径示例（相对进程 CWD，即仓库根目录的上一级）；容器部署时通常改成
# 镜像内绝对路径（如 /app/assets/...），见 docs/deploy.md 的环境变量对照表。
# 未设置时用代码里的内置默认值，不是这里写的示例值。
# WORLD_MODEL_PATH=../世界模型/v18_output/v18_all_master.jsonl
# CTHULHU_MODEL_PATH=../世界模型/cthulhu_extracted/cthulhu_world_model.jsonl
# FRONTEND_DIR=../frontend/dist